.profile-page{width:100%;min-width:0;padding-bottom:10px;color:#172b4d;font-family:"DM Sans",sans-serif}
.profile-page *{box-sizing:border-box}
.profile-breadcrumb{display:flex;align-items:center;gap:10px;margin-bottom:18px;color:#78879b;font-size:12px}
.profile-breadcrumb strong{color:#17243b}
.profile-heading{display:flex;align-items:center;gap:14px;margin-bottom:18px}
.profile-heading-icon{display:grid;place-items:center;width:51px;height:51px;flex-shrink:0;border-radius:14px;background:#e7f7ed;color:#15994d}
.profile-heading h1{margin:0 0 4px;font-family:Manrope,sans-serif;color:#101a2e;font-size:clamp(24px,2.6vw,31px);font-weight:800;letter-spacing:-.8px}
.profile-heading p{margin:0;color:#708198;font-size:12px}
.profile-message{display:flex;align-items:center;gap:8px;margin-bottom:13px;padding:11px 13px;border:1px solid #ccebd7;border-radius:9px;background:#f0fbf4;color:#176b3b;font-size:11px}
.profile-message span{flex:1}.profile-message button{border:0;background:transparent;color:#176b3b;font-size:10px;text-decoration:underline;cursor:pointer}
.profile-top-grid{display:grid;grid-template-columns:minmax(220px,.88fr) minmax(360px,1.4fr) minmax(245px,.9fr);gap:14px;margin-bottom:14px}
.profile-card{min-width:0;padding:17px;background:#fff;border:1px solid #e7eeeb;border-radius:11px;box-shadow:0 3px 14px #102a1f05}
.profile-card h2{display:flex;align-items:center;gap:10px;margin:0;color:#152239;font-family:Manrope,sans-serif;font-size:13px;font-weight:800}
.profile-card h2>svg{flex-shrink:0;color:#101a2e}
.profile-photo-card{display:flex;flex-direction:column;align-items:center;min-height:370px}
.profile-photo-card h2{align-self:flex-start;width:100%}
.profile-photo-wrap{position:relative;width:190px;height:190px;margin:21px auto 16px}
.profile-avatar-large,.profile-photo-wrap>img{display:grid;place-items:center;width:100%;height:100%;border-radius:50%;object-fit:cover}
.profile-avatar-large{background:linear-gradient(140deg,#e4f5e9,#c9e7d2);color:#16834a}
.profile-camera{position:absolute;right:0;bottom:0;display:grid;place-items:center;width:46px;height:46px;border:4px solid white;border-radius:50%;background:#079548;color:white;cursor:pointer}
.profile-photo-button{display:flex;align-items:center;justify-content:center;gap:8px;width:min(100%,210px);min-height:39px;border:1px solid #dce5ec;border-radius:8px;background:#fff;color:#243a57;font-size:11px;font-weight:700;cursor:pointer}
.profile-photo-help{margin-top:10px;color:#7c8da5;font-size:10px;text-align:center}
.profile-personal-card{min-height:370px}
.profile-card-heading{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:13px}
.profile-edit-button{display:flex;align-items:center;gap:7px;padding:8px 11px;border:1px solid #dce5ec;border-radius:7px;background:#fff;color:#263b56;font-size:10px;font-weight:700;cursor:pointer}
.profile-fields{display:grid;grid-template-columns:37px minmax(0,1fr) 37px minmax(0,1fr);align-items:center;gap:10px}
.profile-field-icon{display:grid;place-items:center;width:37px;height:39px;border-radius:9px;background:#f0f5f7;color:#142b4a}
.profile-field-icon svg{width:19px;height:19px}
.profile-fields label{display:flex;flex-direction:column;gap:5px;min-width:0;color:#334966;font-size:10px}
.profile-fields label:nth-of-type(1),.profile-fields label:nth-of-type(2),.profile-fields label:nth-of-type(3),.profile-fields label:nth-of-type(4){grid-column:span 1}
.profile-fields input{width:100%;min-width:0;height:37px;padding:0 10px;border:1px solid #dce5ec;border-radius:7px;background:#fbfcfd;color:#142b4a;font-size:10px;outline-color:#15994d}
.profile-fields input:disabled{opacity:1}
.profile-role{display:inline-flex;align-items:center;width:max-content;padding:8px 12px;border-radius:7px;background:#e4f8eb;color:#16834a;font-size:10px;font-weight:700}
.profile-statistics{min-height:370px}
.profile-statistics h2{margin-bottom:15px}
.profile-stat{display:flex;align-items:center;gap:11px;padding:10px;margin-bottom:10px;border-radius:9px}
.profile-stat>span{display:grid;place-items:center;width:43px;height:43px;flex-shrink:0;border-radius:10px;background:#fff8}
.profile-stat>span svg{width:23px;height:23px}
.profile-stat>div{min-width:0}
.profile-stat strong,.profile-stat small{display:block}
.profile-stat strong{font-family:Manrope,sans-serif;color:#101a2e;font-size:21px;font-weight:800}
.profile-stat small{margin-top:2px;color:#334b68;font-size:10px}
.profile-stat.blue{background:#eaf4ff;color:#1680ee}.profile-stat.blue>span{background:#d8ebff}
.profile-stat.green{background:#e8f8ee;color:#15994d}.profile-stat.green>span{background:#d5f3e1}
.profile-stat.yellow{background:#fff6df;color:#e7a100}.profile-stat.yellow>span{background:#ffedbd}
.profile-stat.purple{background:#f1eaff;color:#8b5cf6}.profile-stat.purple>span{background:#e6d9ff}
.profile-demo-caption{margin:8px 0 0;color:#9aa4b0;font-size:9px}
.profile-bottom-grid{display:grid;grid-template-columns:minmax(260px,1.05fr) minmax(320px,1.15fr) minmax(280px,1fr);gap:14px}
.profile-password-card h2,.profile-notifications-card h2,.profile-preferences-card h2{margin-bottom:7px}
.profile-password-card form{display:grid;gap:13px;margin-top:18px}
.profile-password-card form>label{display:grid;gap:6px;color:#263b56;font-size:11px}
.profile-password-input{display:flex;align-items:center;min-width:0;height:39px;border:1px solid #dce5ec;border-radius:7px;background:#fff}
.profile-password-input input{width:100%;min-width:0;height:100%;padding:0 10px;border:0;outline:0;background:transparent;color:#263b56;font-size:11px}
.profile-password-input input::placeholder{color:#92a0b1}
.profile-password-input button{display:grid;place-items:center;width:34px;height:100%;flex-shrink:0;border:0;background:transparent;color:#526680;cursor:pointer}
.profile-password-input button svg{width:15px;height:15px}
.profile-submit{display:flex;align-items:center;justify-content:center;gap:9px;width:100%;min-height:43px;margin-top:5px;padding:10px;border:0;border-radius:7px;background:#079548;color:#fff;font-size:11px;font-weight:750;cursor:pointer}
.profile-submit:hover{background:#087c3e}
.profile-security-note{margin:10px 0 0;color:#8995a5;font-size:9px;line-height:1.5}
.profile-card-subtitle{margin:0 0 14px;color:#718198;font-size:10px}
.profile-notification-list{display:grid;gap:8px}
.profile-notification{display:flex;align-items:center;gap:10px;min-width:0}
.profile-notification-icon{display:grid;place-items:center;width:41px;height:41px;flex-shrink:0;border-radius:10px}
.profile-notification-icon.red{background:#ffebeb;color:#f04438}.profile-notification-icon.green{background:#e3f8eb;color:#15994d}.profile-notification-icon.blue{background:#e8f3ff;color:#1680ee}.profile-notification-icon.purple{background:#f0eaff;color:#8b5cf6}.profile-notification-icon.yellow{background:#fff4d8;color:#e7a100}
.profile-notification-copy{flex:1;min-width:0}
.profile-notification-copy strong,.profile-notification-copy small{display:block}
.profile-notification-copy strong{color:#1c2b42;font-size:10px}
.profile-notification-copy small{margin-top:3px;color:#718198;font-size:9px;line-height:1.4}
.profile-switch{position:relative;width:43px;height:24px;flex-shrink:0;padding:0;border:0;border-radius:30px;background:#d7dfe6;cursor:pointer;transition:background .15s}
.profile-switch span{position:absolute;left:3px;top:3px;width:18px;height:18px;border-radius:50%;background:#fff;box-shadow:0 1px 3px #0002;transition:transform .15s}
.profile-switch.on{background:#079548}
.profile-switch.on span{transform:translateX(19px)}
.profile-preference-row{display:grid;grid-template-columns:34px minmax(0,1fr);align-items:center;gap:10px;margin-bottom:10px}
.profile-preference-row>span{display:grid;place-items:center;width:34px;height:36px;border-radius:8px;background:#f0f5f7;color:#243a57}
.profile-preference-row>span svg{width:18px;height:18px}
.profile-preference-row label{display:grid;grid-template-columns:80px minmax(0,1fr);align-items:center;gap:8px;min-width:0;color:#334966;font-size:10px}
.profile-preference-row select{width:100%;min-width:0;height:37px;padding:0 8px;border:1px solid #dce5ec;border-radius:7px;background:#fff;color:#253b58;font-size:10px}
.profile-preferences-card .profile-submit{margin-top:17px}
.profile-footer{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 2px 5px;color:#8995a5;font-size:9px}
.profile-footer span:first-child{display:flex;align-items:center;gap:6px}
.profile-footer i{width:7px;height:7px;border-radius:50%;background:#20ad5b}
@media(max-width:1250px){.profile-top-grid{grid-template-columns:minmax(200px,.75fr) minmax(340px,1.4fr)}.profile-statistics{grid-column:1/-1;min-height:auto}.profile-statistics .profile-stat{display:inline-flex;width:calc(25% - 9px);vertical-align:top}.profile-bottom-grid{grid-template-columns:1fr 1fr}.profile-preferences-card{grid-column:1/-1}.profile-preferences-card .profile-preference-row{display:inline-grid;width:49%;padding-right:10px}}
@media(max-width:800px){.profile-top-grid,.profile-bottom-grid{grid-template-columns:1fr}.profile-statistics,.profile-preferences-card{grid-column:auto}.profile-statistics .profile-stat{display:flex;width:100%}.profile-preferences-card .profile-preference-row{display:grid;width:100%;padding:0}.profile-photo-card{min-height:auto}.profile-personal-card{min-height:auto}}
@media(max-width:480px){.profile-card{padding:13px}.profile-heading p{font-size:11px}.profile-fields{grid-template-columns:35px minmax(0,1fr);gap:9px}.profile-fields label{grid-column:2!important}.profile-fields .profile-field-icon{grid-column:1;grid-row:span 1}.profile-fields label:nth-of-type(5),.profile-fields label:nth-of-type(6){grid-column:2}.profile-preference-row label{grid-template-columns:70px minmax(0,1fr)}.profile-footer{align-items:flex-start;flex-direction:column}}
