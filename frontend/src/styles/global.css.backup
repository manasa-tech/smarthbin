:root {
  font-family: "DM Sans", Inter, Arial, sans-serif;
  color: #172b4d;
  background: #f4f7f6;
  --green: #16834a;
  --green-dark: #116b3d;
  --green-soft: #e7f5ec;
  --navy: #101a2e;
  --text: #172b4d;
  --muted: #7c8a9d;
  --border: #e5ebe8;
  --surface: #ffffff;
  --canvas: #f4f7f6;
  --radius: 16px;
  --shadow: 0 4px 18px rgba(16, 42, 31, 0.045);
}

* { box-sizing: border-box; }

html, body, #root {
  width: 100%;
  min-height: 100%;
  margin: 0;
}

body {
  min-width: 320px;
  background: var(--canvas);
  color: var(--text);
  font-size: 14px;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

button, input, select, textarea { font: inherit; }
button { cursor: pointer; }

.app-shell {
  display: flex;
  width: 100%;
  min-height: 100vh;
  margin: 0;
  padding: 0;
  gap: 0;
  background: var(--canvas);
}

.app-main {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  min-height: 100vh;
  margin: 0 !important;
  padding: 0;
  position: relative;
  display: flex;
  flex-direction: column;
  background: var(--canvas);
}

.app-content {
  flex: 1;
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 30px;
  background: var(--canvas);
}

.app-content > h1,
.app-content > h2 {
  margin: 0 0 12px;
  font-family: "Manrope", "DM Sans", sans-serif;
  font-weight: 800;
  letter-spacing: -0.8px;
}

.app-content > h1 { font-size: clamp(26px, 3vw, 34px); }
.app-content > h2 { font-size: 24px; }

.app-content p {
  color: #66768b;
  line-height: 1.7;
}

.app-content section,
.app-content article { min-width: 0; }

.app-content input,
.app-content select,
.app-content textarea {
  max-width: 100%;
  min-height: 42px;
  padding: 10px 13px;
  color: var(--text);
  background: #fff;
  border: 1px solid #dce5df;
  border-radius: 10px;
  outline: none;
}

.app-content textarea { min-height: 110px; resize: vertical; }

.app-content input:focus,
.app-content select:focus,
.app-content textarea:focus {
  border-color: #63b88a;
  box-shadow: 0 0 0 3px rgba(22, 131, 74, 0.09);
}

.app-content button:not([class]) {
  padding: 9px 14px;
  color: var(--text);
  background: white;
  border: 1px solid var(--border);
  border-radius: 10px;
}

.app-content button:not([class]):hover {
  background: #f2f8f4;
  border-color: #b9d9c5;
}

.app-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  width: 100%;
  margin: 0;
  padding: 17px 30px;
  color: var(--muted);
  background: #fff;
  border-top: 1px solid var(--border);
  font-size: 12px;
}

.dashboard-page,
.simulator-page,
.classifier-page,
.route-page,
.prediction-page,
.report-page {
  width: 100%;
  max-width: 1600px;
  margin: 0 auto;
}

.dashboard-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 26px;
}

.dashboard-header h1 { margin: 0 0 6px; }
.dashboard-header p { margin: 0; }

.dashboard-stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  margin-bottom: 24px;
}

.dashboard-stat-card,
.dashboard-panel,
.stat-card,
.priority-queue,
.upload-box,
.classifier-result,
.disposal-tip {
  min-width: 0;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.dashboard-stat-card,
.dashboard-panel { padding: 23px; }

.dashboard-stat-card { transition: transform .2s, box-shadow .2s; }
.dashboard-stat-card:hover { transform: translateY(-3px); }

.dashboard-content-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.5fr) minmax(280px, 1fr);
  gap: 22px;
  align-items: start;
}

.dashboard-panel h2,
.dashboard-panel h3 { margin: 0 0 18px; }

.dashboard-chart-container,
.dashboard-map-container {
  width: 100%;
  min-width: 0;
  overflow: hidden;
  border-radius: 12px;
}

.dashboard-bin-list,
.priority-queue-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.dashboard-quick-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.dashboard-quick-actions button {
  padding: 16px;
  background: #f7faf8;
  border: 1px solid var(--border);
  border-radius: 12px;
}

.dashboard-quick-actions button:hover {
  background: var(--green-soft);
  border-color: #b8dec5;
}

.dashboard-progress-container,
.dashboard-progress-track {
  height: 7px;
  overflow: hidden;
  background: #edf1ee;
  border-radius: 20px;
}

.dashboard-progress-bar,
.dashboard-progress-fill {
  height: 100%;
  background: #22a06b;
  border-radius: inherit;
}

.priority-queue-item {
  width: 100%;
  padding: 12px;
  text-align: left;
  background: white;
  border: 1px solid #edf1ee;
  border-radius: 12px;
}

.priority-queue-item:hover { background: #f5faf6; }

.upload-box-dropzone {
  width: 100%;
  min-height: 210px;
  padding: 24px;
  background: #f8fbf9;
  border: 2px dashed #cbded0;
  border-radius: 14px;
}

.upload-box-dropzone:hover { background: #eef8f0; }

.upload-box-classify,
.classifier-result-reset,
.dashboard-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 42px;
  padding: 11px 17px;
  color: white;
  background: var(--green);
  border: 1px solid var(--green);
  border-radius: 10px;
  font-weight: 600;
}

.upload-box-classify { width: 100%; margin-top: 16px; }
.upload-box-classify:hover,
.classifier-result-reset:hover,
.dashboard-btn:hover { background: var(--green-dark); }

.classifier-result-recommendation,
.disposal-tip-recommendation {
  padding: 15px;
  background: #f0f8f2;
  border: 1px solid #e1f0e5;
  border-radius: 12px;
}

.disposal-tip-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 12px 0;
}

.disposal-tip-item-icon {
  display: grid;
  flex-shrink: 0;
  place-items: center;
  width: 36px;
  height: 36px;
  color: var(--green);
  background: var(--green-soft);
  border-radius: 10px;
}

.app-content table {
  width: 100%;
  border-collapse: collapse;
  background: white;
}

.app-content th,
.app-content td {
  padding: 13px 15px;
  text-align: left;
  border-bottom: 1px solid #edf1ee;
}

.app-content th {
  color: #66768b;
  background: #f7faf8;
  font-size: 12px;
  font-weight: 700;
}

.app-content tr:hover td { background: #fbfdfb; }

@media (max-width: 1100px) {
  .dashboard-content-grid { grid-template-columns: minmax(0, 1fr); }
}

@media (max-width: 768px) {
  .app-content { padding: 17px; }
  .app-content > h1 { font-size: 27px; }
  .dashboard-stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .dashboard-stat-card, .dashboard-panel { padding: 16px; }
  .app-footer { padding: 14px 17px; }
  .app-content table { display: block; overflow-x: auto; }
}

@media (max-width: 440px) {
  .dashboard-stats-grid,
  .dashboard-quick-actions { grid-template-columns: minmax(0, 1fr); }
}
