@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap");

.auth-page {
  min-height: 100vh;
  padding: 24px;
  display: grid;
  place-items: center;
  color: #10272e;
  background: linear-gradient(135deg, #e5f4e5, #f5faef 55%, #d7edda);
  font-family: "DM Sans", sans-serif;
}
.auth-page * { box-sizing: border-box; }
.auth-page button, .auth-page input { font: inherit; }
.auth-page button { cursor: pointer; }
.auth-page a { text-decoration: none; }

.auth-layout {
  width: min(1450px, 100%);
  min-height: min(900px, calc(100vh - 48px));
  display: grid;
  grid-template-columns: 1.08fr .92fr;
  overflow: hidden;
  border: 1px solid #ffffff;
  border-radius: 28px;
  background: #fff;
  box-shadow: 0 24px 80px #174a2c17;
}

/* Left side */
.auth-visual {
  position: relative;
  min-height: 820px;
  padding: 30px 36px 25px;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  isolation: isolate;
  background: linear-gradient(145deg, #f9fff6, #e4f5df);
}
.auth-brand, .auth-mobile-brand {
  position: relative;
  z-index: 5;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  width: fit-content;
  color: #10272e;
  font-family: "Manrope", sans-serif;
  font-size: 24px;
  font-weight: 800;
  letter-spacing: -1px;
}
.auth-brand b, .auth-mobile-brand b { color: #07843e; }
.auth-brand-icon {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  color: white;
  background: linear-gradient(145deg, #19ad5a, #08783a);
  border-radius: 14px;
}
.auth-visual-copy {
  position: relative;
  z-index: 2;
  max-width: 530px;
  margin-top: 48px;
}
.auth-eyebrow {
  color: #176044;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 2.2px;
}
.auth-visual-copy h1 {
  margin: 19px 0 15px;
  color: #10272e;
  font-family: "Manrope", sans-serif;
  font-size: clamp(35px, 3.25vw, 49px);
  line-height: 1.12;
  font-weight: 800;
  letter-spacing: -2px;
}
.auth-visual-copy h1 span { color: #087b49; }
.auth-visual-copy > p {
  max-width: 430px;
  margin: 0;
  color: #53656b;
  font-size: 14px;
  line-height: 1.75;
}
.auth-benefits {
  position: relative;
  z-index: 3;
  margin-top: 28px;
  display: grid;
  gap: 13px;
}
.auth-benefits > div {
  display: flex;
  align-items: center;
  gap: 13px;
}
.auth-benefits > div > span {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  color: #07843e;
  border: 1px solid #cce7cd;
  border-radius: 50%;
  background: #ffffffc9;
}
.auth-benefits strong {
  color: #183d31;
  font-size: 12px;
  line-height: 1.45;
}

/* Illustrated smart city */
.auth-city {
  position: absolute;
  z-index: 1;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  background: linear-gradient(180deg, #dff3f9 0%, #e9f7ec 56%, #b1d99b 100%);
  clip-path: inset(0);
}
.auth-city::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, #f5fff3 0%, #f4fff2e8 27%, transparent 74%);
}
.auth-sun {
  position: absolute;
  top: 15%;
  right: 17%;
  width: 55px;
  height: 55px;
  border-radius: 50%;
  background: #fff4bd;
  box-shadow: 0 0 45px #fff4bd75;
}
.auth-skyline {
  position: absolute;
  right: 0;
  bottom: 30%;
  left: 35%;
  height: 42%;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  gap: 5px;
  opacity: .85;
}
.auth-skyline i {
  width: 12%;
  height: 58%;
  border: 1px solid #ffffffa8;
  background: linear-gradient(90deg, #9ec7d2, #eff9fa 48%, #8bb6c8);
  clip-path: polygon(12% 0, 88% 0, 100% 100%, 0 100%);
}
.auth-skyline i:nth-child(2) { height: 80%; }
.auth-skyline i:nth-child(3) { height: 100%; width: 15%; }
.auth-skyline i:nth-child(4) { height: 69%; }
.auth-skyline i:nth-child(5) { height: 88%; width: 14%; }
.auth-skyline i:nth-child(6) { height: 53%; }

.auth-park-hill {
  position: absolute;
  right: -12%;
  bottom: 10%;
  left: -12%;
  height: 32%;
  border-radius: 50% 50% 0 0;
  background: linear-gradient(160deg, #9acb7b, #3d9251);
}
.auth-park-path {
  position: absolute;
  right: -15%;
  bottom: -13%;
  left: -14%;
  height: 27%;
  border-radius: 50% 50% 0 0;
  background: #e7dfbd;
  border-top: 5px solid #f7f2d9;
  transform: rotate(-5deg);
}
.auth-tree {
  position: absolute;
  z-index: 2;
  bottom: 21%;
  width: 12px;
  height: 100px;
  border-radius: 8px;
  background: #8a6844;
}
.auth-tree::before {
  content: "";
  position: absolute;
  top: -44px;
  left: -33px;
  width: 78px;
  height: 75px;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #b2e27b, #30834a 75%);
  box-shadow: 19px 11px 0 #5da54b, -13px 14px 0 #7dbd5b;
}
.auth-tree-one { right: 8%; }
.auth-tree-two { left: 42%; bottom: 17%; transform: scale(.7); }

.auth-bin {
  position: absolute;
  z-index: 4;
  right: 24%;
  bottom: 7%;
  width: 132px;
  filter: drop-shadow(10px 13px 12px #16412b4d);
}
.auth-bin-lid {
  height: 20px;
  margin-left: -5%;
  width: 110%;
  border-radius: 12px 12px 5px 5px;
  background: linear-gradient(#1b7445, #07542f);
}
.auth-bin-body {
  min-height: 221px;
  padding: 17px 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  color: white;
  border: 2px solid #42a969;
  border-radius: 6px 6px 15px 15px;
  background: linear-gradient(90deg, #08723c, #0c9950 48%, #075c35);
}
.auth-bin-body small {
  font-size: 7px;
  letter-spacing: 1px;
  color: #c9f8d5;
}
.auth-bin-body b {
  font-size: 11px;
  font-family: "Manrope", sans-serif;
}
.auth-wheel {
  position: absolute;
  bottom: -10px;
  width: 25px;
  height: 25px;
  border: 5px solid #163c29;
  border-radius: 50%;
  background: #334f3c;
}
.auth-wheel-one { left: 13px; }
.auth-wheel-two { right: 13px; }

.auth-float-card {
  position: absolute;
  z-index: 5;
  padding: 11px;
  color: #183a30;
  border: 1px solid #ffffff;
  border-radius: 13px;
  background: #ffffffed;
  box-shadow: 0 10px 27px #154c301c;
}
.auth-fill-card {
  right: 4%;
  bottom: 39%;
  width: 130px;
}
.auth-fill-card > small {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 9px;
  font-weight: 800;
}
.auth-progress-ring {
  width: 64px;
  height: 64px;
  margin: 10px auto;
  display: grid;
  place-items: center;
  border: 7px solid #13994d;
  border-right-color: #d9efdf;
  border-radius: 50%;
}
.auth-progress-ring b { font-size: 14px; }
.auth-live-dot { color: #687a70; font-size: 8px; }
.auth-live-dot::before {
  content: "";
  display: inline-block;
  width: 6px;
  height: 6px;
  margin-right: 5px;
  border-radius: 50%;
  background: #0da251;
}
.auth-status-card {
  right: 4%;
  bottom: 22%;
  display: flex;
  align-items: center;
  gap: 9px;
}
.auth-status-icon {
  width: 31px;
  height: 31px;
  display: grid;
  place-items: center;
  color: #07843e;
  background: #e5f8e8;
  border-radius: 9px;
}
.auth-status-card small,
.auth-status-card b { display: block; }
.auth-status-card small { color: #687a70; font-size: 9px; }
.auth-status-card b { margin-top: 3px; font-size: 10px; }

.auth-visual-footer {
  position: relative;
  z-index: 5;
  margin-top: auto;
  display: flex;
  align-items: center;
  gap: 7px;
  color: #246546;
  font-size: 11px;
  font-weight: 700;
}

/* Right form panel */
.auth-form-panel {
  min-width: 0;
  padding: 38px clamp(24px, 4vw, 65px);
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(ellipse at top right, #f3fae9, transparent 36%),
    #fff;
}
.auth-form-inner { width: 100%; max-width: 490px; }
.auth-mobile-brand {
  display: none;
  margin: 0 auto 28px;
  font-size: 21px;
}
.auth-form-heading { text-align: center; }
.auth-heading-icon {
  width: 47px;
  height: 47px;
  margin: 0 auto 12px;
  display: grid;
  place-items: center;
  color: #07843e;
  border-radius: 15px;
  background: #e7f7e8;
}
.auth-form-heading h2 {
  margin: 0;
  font-family: "Manrope", sans-serif;
  font-size: clamp(25px, 2.5vw, 33px);
  line-height: 1.25;
  letter-spacing: -1px;
}
.auth-form-heading p {
  margin: 9px 0 22px;
  color: #647078;
  font-size: 13px;
  line-height: 1.6;
}

.auth-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 7px;
  margin-bottom: 22px;
  padding: 4px;
  border-radius: 13px;
  background: #f0f4f0;
}
.auth-tabs button {
  min-height: 42px;
  border: 0;
  border-radius: 10px;
  color: #53635e;
  background: transparent;
  font-size: 13px;
  font-weight: 700;
}
.auth-tabs button.selected {
  color: white;
  background: linear-gradient(110deg, #0b8241, #08713a);
  box-shadow: 0 4px 10px #087b3c20;
}

.auth-form { display: grid; gap: 15px; }
.auth-field { min-width: 0; display: grid; gap: 7px; }
.auth-field > span {
  color: #21383d;
  font-size: 12px;
  font-weight: 700;
}
.auth-input-wrap {
  min-width: 0;
  min-height: 47px;
  padding: 0 13px;
  display: flex;
  align-items: center;
  gap: 11px;
  color: #6b7a7e;
  border: 1px solid #d9e0e0;
  border-radius: 11px;
  background: #fff;
  transition: border-color .2s, box-shadow .2s;
}
.auth-input-wrap:focus-within {
  border-color: #16934b;
  box-shadow: 0 0 0 3px #07843e12;
}
.auth-input-wrap > svg { flex-shrink: 0; }
.auth-input-wrap input {
  width: 100%;
  min-width: 0;
  height: 44px;
  padding: 0;
  color: #173138;
  border: 0;
  outline: 0;
  background: transparent;
  font-size: 12px;
}
.auth-input-wrap input::placeholder { color: #909a9f; }
.auth-eye {
  padding: 5px;
  display: grid;
  place-items: center;
  color: #6b7a7e;
  border: 0;
  border-radius: 7px;
  background: transparent;
}
.auth-eye:hover { color: #07843e; background: #eef8ee; }

.auth-terms {
  display: flex;
  align-items: flex-start;
  gap: 9px;
  color: #4e5c61;
  font-size: 11px;
  line-height: 1.6;
}
.auth-terms input {
  width: 16px;
  height: 16px;
  margin: 1px 0 0;
  accent-color: #07843e;
  flex-shrink: 0;
}
.auth-terms a { color: #07843e; font-weight: 700; text-decoration: underline; }
.auth-forgot-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  color: #748078;
  font-size: 11px;
}
.auth-forgot-row button {
  padding: 0;
  color: #07843e;
  border: 0;
  background: transparent;
  font-size: 11px;
  font-weight: 700;
}
.auth-message {
  margin: 0;
  padding: 10px 12px;
  color: #185c35;
  border: 1px solid #c9e8ce;
  border-radius: 9px;
  background: #effaf0;
  font-size: 12px;
  line-height: 1.5;
}
.auth-submit {
  min-height: 49px;
  margin-top: 2px;
  padding: 0 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 11px;
  color: white;
  border: 0;
  border-radius: 11px;
  background: linear-gradient(105deg, #0a8a43, #08743b);
  box-shadow: 0 6px 15px #07843e20;
  font-size: 13px;
  font-weight: 800;
  transition: transform .2s, background .2s;
}
.auth-submit:hover {
  transform: translateY(-1px);
  background: #075e31;
}

.auth-divider {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 21px 0 15px;
  color: #748078;
  font-size: 11px;
}
.auth-divider::before, .auth-divider::after {
  content: "";
  height: 1px;
  flex: 1;
  background: #e0e6e0;
}
.auth-divider span { white-space: nowrap; }

.auth-socials {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 9px;
}
.auth-socials button {
  min-width: 0;
  min-height: 43px;
  padding: 7px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  color: #273c40;
  border: 1px solid #dce3e1;
  border-radius: 10px;
  background: white;
  font-size: 11px;
  font-weight: 700;
  transition: background .2s, border-color .2s;
}
.auth-socials button:hover {
  border-color: #9ecdaa;
  background: #f5fbf3;
}
.auth-google-mark {
  color: #4285f4;
  font-family: Arial, sans-serif;
  font-size: 19px;
  font-weight: 800;
}
.auth-microsoft-mark {
  width: 16px;
  height: 16px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2px;
}
.auth-microsoft-mark i:nth-child(1) { background: #f25022; }
.auth-microsoft-mark i:nth-child(2) { background: #7fba00; }
.auth-microsoft-mark i:nth-child(3) { background: #00a4ef; }
.auth-microsoft-mark i:nth-child(4) { background: #ffb900; }
.auth-apple-mark { color: #111; font-size: 17px; }

.auth-switch {
  margin: 22px 0 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 5px;
  color: #69757a;
  font-size: 12px;
}
.auth-switch button {
  padding: 0;
  color: #07843e;
  border: 0;
  background: transparent;
  font-size: 12px;
  font-weight: 800;
}
.auth-switch button:hover { text-decoration: underline; }

.auth-back-link {
  width: fit-content;
  margin: 19px auto 0;
  display: flex;
  align-items: center;
  gap: 6px;
  color: #75827b;
  font-size: 11px;
}
.auth-back-link svg { transform: rotate(180deg); }
.auth-back-link:hover { color: #07843e; }

/* Responsive */
@media (max-width: 1050px) {
  .auth-page { padding: 15px; }
  .auth-layout { grid-template-columns: .92fr 1.08fr; }
  .auth-visual { padding: 25px; min-height: 790px; }
  .auth-visual-copy { margin-top: 38px; }
  .auth-visual-copy h1 { font-size: 36px; }
  .auth-form-panel { padding: 32px 28px; }
  .auth-bin { right: 19%; transform: scale(.9); transform-origin: bottom; }
  .auth-fill-card { right: 2%; }
}

@media (max-width: 760px) {
  .auth-page { padding: 0; display: block; }
  .auth-layout {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: visible;
    border: 0;
    border-radius: 0;
  }
  .auth-visual {
    min-height: 390px;
    padding: 23px;
  }
  .auth-brand { font-size: 20px; }
  .auth-brand-icon { width: 36px; height: 36px; }
  .auth-visual-copy {
    max-width: 500px;
    margin-top: 30px;
    padding-bottom: 140px;
  }
  .auth-visual-copy h1 { max-width: 450px; font-size: clamp(31px, 6vw, 43px); }
  .auth-visual-copy > p { max-width: 440px; font-size: 13px; }
  .auth-benefits { display: none; }
  .auth-city { top: 0; opacity: .65; }
  .auth-bin { right: 13%; bottom: 0; transform: scale(.56); transform-origin: bottom right; }
  .auth-fill-card { right: 3%; bottom: 14%; transform: scale(.82); transform-origin: bottom right; }
  .auth-status-card { display: none; }
  .auth-visual-footer { display: none; }
  .auth-form-panel { padding: 34px 23px 42px; }
  .auth-mobile-brand { display: inline-flex; }
  .auth-form-inner { max-width: 480px; }
}

@media (max-width: 420px) {
  .auth-visual { min-height: 365px; padding: 20px; }
  .auth-visual-copy { margin-top: 25px; padding-bottom: 115px; }
  .auth-visual-copy h1 { font-size: 32px; letter-spacing: -1.2px; }
  .auth-eyebrow { font-size: 8px; letter-spacing: 1.4px; }
  .auth-bin { right: 8%; transform: scale(.46); transform-origin: bottom right; }
  .auth-fill-card { right: 1%; bottom: 8%; transform: scale(.7); transform-origin: bottom right; }
  .auth-form-panel { padding: 28px 18px 35px; }
  .auth-form-heading h2 { font-size: 26px; }
  .auth-socials { gap: 6px; }
  .auth-socials button { gap: 4px; font-size: 10px; }
}
